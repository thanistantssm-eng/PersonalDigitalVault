{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=PersonalDigitalVaultMssqlDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "PersonalDigitalVault.Api",
    "Audience": "PersonalDigitalVault.Client",
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "ExpiryMinutes": 60
  },
  "Encryption": {
    "KeyBase64": ""
  },
  "Storage": {
    "RootPath": "ProtectedStorage",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".txt",
      ".jpg",
      ".jpeg",
      ".png"
    ]
  },
  "Database": {
    "AutoMigrateInDevelopment": true
  },
  "SeedAdmin": {
    "Enabled": false,
    "Email": "admin@pdv.local",
    "Password": "ChangeMe!123",
    "FullName": "System Administrator"
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
